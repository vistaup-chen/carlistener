<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ 需要闹钟权限才能使用 setExactAndAllowWhileIdle -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 6+ 需要唤醒锁权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".NotifierApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="通知测试"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 接收 AlarmManager 触发的广播 -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.chen.notifier.SEND_NOTIFICATION" />
                <action android:name="com.chen.notifier.SEND_SMS" />
                <action android:name="com.chen.notifier.COUNTDOWN_UPDATE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>

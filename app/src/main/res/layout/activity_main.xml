<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="车辆监听器配置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 关键字配置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关键字匹配（短信内容和通知内容都会匹配）："
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/keywordEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="驶离,处罚,交警,违停"
            android:inputType="text"
            android:layout_marginTop="4dp" />

        <!-- 短信号码配置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="监听的短信号码（多个用逗号分隔）："
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/senderNumbersEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="12123,121233300"
            android:inputType="text"
            android:layout_marginTop="4dp" />

        <!-- 通知监听应用选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="监听应用（点击选择）："
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/selectedAppTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@android:drawable/edit_text"
            android:text="交管12123（com.tmri.app.main）"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/selectAppButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择应用"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/quick12123Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="一键监听12123"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- 权限按钮 -->
        <Button
            android:id="@+id/smsPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="授予短信权限"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/notificationPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用通知监听"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/autoStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自启动设置"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/batteryOptButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电池优化白名单"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/notifSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知设置"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/fullScreenSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="全屏弹窗设置"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/overlayPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="悬浮窗权限"
            android:layout_marginTop="8dp" />

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存配置"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/testRingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试响铃"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/testPopupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="静默弹窗测试"
            android:layout_marginTop="8dp" />

        <!-- 状态显示 -->
        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态："
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:background="#F0F0F0"
            android:textColor="#333333"
            android:padding="12dp" />

        <!-- 使用说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用说明：\n1. 首次启动会自动申请短信权限，请点击「允许」\n2. 点击「启用通知监听」→ 找到「车辆监听器」→ 开启开关\n3. 点击「自启动设置」→ 允许本应用自启动（不同手机路径不同）\n4. 点击「电池优化白名单」→ 选择「允许」\n5. 短信号码默认 12123/121233300，收到即响铃（不管内容）\n6. 关键字同时匹配短信内容和通知内容，命中任一即响铃\n7. 短信号码和关键字是 OR 关系，满足任一条件就触发\n8. 响铃时会弹出全屏提醒界面，点击「关闭提醒」可停止\n9. 不手动关闭则 5 分钟后自动停止\n10. 可用「测试响铃」按钮验证铃声是否正常"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:textColor="#CCCCCC"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>
